{
  "name": "out-of-auto",
  "version": "0.1.0",
  "description": "Out of Auto: a photography workbook. What the camera decides for you, and how to take each decision back, for nature photography with a long zoom.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node --experimental-strip-types tools/icons.mjs",
    "photos:find": "vite-node tools/photos/find.ts --",
    "photos:fetch": "vite-node tools/photos/fetch.ts --",
    "photos:import": "vite-node tools/photos/import.ts --"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/nunito-sans": "^5.2.0",
    "@fontsource/kalam": "^5.3.0",
    "@types/node": "^20.19.43",
    "happy-dom": "^20.14.6",
    "sharp": "^0.34.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "didactics": "github:RobertLitzke/Didactics#cf3cc2048effce852e94c7c0d0cfd75fd0098926"
  }
}
