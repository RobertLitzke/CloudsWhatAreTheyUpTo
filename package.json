{
  "name": "courses",
  "version": "0.1.0",
  "description": "A shelf of interactive workbooks: a catalog page and one folder per course, each built on Didactics.",
  "type": "module",
  "private": true,
  "homepage": "https://robertlitzke.github.io/Courses/",
  "workspaces": [
    "catalog",
    "courses/*",
    "courses/*/packages/*"
  ],
  "scripts": {
    "build": "node tools/build-site.mjs",
    "test": "npm test --workspaces --if-present",
    "preview": "vite preview --config catalog/vite.config.ts",
    "review-queue": "node tools/review-queue.mjs",
    "copyedit": "node tools/copyedit.mjs",
    "photos": "node tools/photos.mjs",
    "photos:find": "node tools/photos-find.mjs",
    "restore-photos": "node tools/restore-photos.mjs",
    "pictures:check": "node tools/pictures-check.mjs",
    "pictures:paleoart": "node tools/pictures-check.mjs --paleoart",
    "icons": "node tools/process-icons.mjs",
    "status": "node tools/status.mjs",
    "release": "node tools/release.mjs"
  },
  "dependencies": {
    "didactics": "github:RobertLitzke/Didactics#163b67c7215be29238b913c329d2588632b6bde5"
  }
}
