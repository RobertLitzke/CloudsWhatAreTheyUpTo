{
  "name": "dirt",
  "version": "0.1.0",
  "description": "Dirt: a gardener's workbook on soil. What it is made of, how it holds water and air, what lives in it, and how to feed and build it.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node tools/icons.mjs",
    "photos:find": "node --experimental-strip-types tools/photos/find.ts",
    "photos:fetch": "node --experimental-strip-types tools/photos/fetch.ts"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/nunito-sans": "^5.2.0",
    "@fontsource/kalam": "^5.3.0",
    "@types/node": "^20.19.43",
    "happy-dom": "^20.14.6",
    "sharp": "^0.34.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "didactics": "github:RobertLitzke/Didactics#cf3cc2048effce852e94c7c0d0cfd75fd0098926"
  }
