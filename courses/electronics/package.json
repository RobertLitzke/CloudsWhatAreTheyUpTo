{
  "name": "circuitry",
  "version": "0.1.0",
  "description": "Circuitry: a workbook on circuits. Voltage and current you can watch, the parts that shape them, debugging boards, and branches into guitar pedals and off-grid solar.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node tools/icons.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/nunito-sans": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/kalam": "^5.3.0",
    "@types/node": "^20.19.43",
    "happy-dom": "^20.14.6",
    "sharp": "^0.34.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "circuit-kit": "*",
    "didactics": "github:RobertLitzke/Didactics#855b4ee9b4f8568d6241bc3a126ed27729661f40"
